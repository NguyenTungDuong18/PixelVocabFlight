<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <!-- The synthesiser of the intro soundtrack (pure C#, no UnityEngine): the game and this tool share the very same files. -->
    <Compile Include="../../Game/Assets/_Project/Scripts/Unity/Audio/Cinema/*.cs" Link="Cinema/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
