<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <!-- NLayer decodes MP3 here only (offline); the game never sees it. The WAV reader/writer and DSP blocks are the game's own files. -->
    <PackageReference Include="NLayer" Version="1.16.0" />
    <Compile Include="../../Game/Assets/_Project/Scripts/Unity/Audio/Cinema/CinemaDsp.cs" Link="Cinema/CinemaDsp.cs" />
    <Compile Include="../../Game/Assets/_Project/Scripts/Unity/Audio/Cinema/CinemaWav.cs" Link="Cinema/CinemaWav.cs" />
    <Compile Include="../../Game/Assets/_Project/Scripts/Unity/Audio/Cinema/CinemaBank.cs" Link="Cinema/CinemaBank.cs" />
  </ItemGroup>
</Project>
