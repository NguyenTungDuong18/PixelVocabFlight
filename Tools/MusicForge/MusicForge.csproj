<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Optimize>true</Optimize>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <!-- The sample cache (VSCO 2 CE, ~1 GB, filled by `fetch`) stays out of git and out of the build. -->
    <Compile Remove="samples/**" />
    <None Remove="samples/**" />
    <!-- The game's own WAV reader/writer (pure C#), shared like Tools/AudioImport does. -->
    <Compile Include="../../Game/Assets/_Project/Scripts/Unity/Audio/Cinema/CinemaDsp.cs" Link="Cinema/CinemaDsp.cs" />
    <Compile Include="../../Game/Assets/_Project/Scripts/Unity/Audio/Cinema/CinemaWav.cs" Link="Cinema/CinemaWav.cs" />
  </ItemGroup>
</Project>
